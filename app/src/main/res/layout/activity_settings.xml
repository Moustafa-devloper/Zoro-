<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            style="@style/NexusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbDarkTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark theme"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbAmoled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AMOLED mode"
                android:textColor="@color/text_primary" />

            <CheckBox
                android:id="@+id/cbHaptics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Haptic feedback"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            style="@style/NexusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel size: 80%"
                android:textColor="@color/text_primary" />

            <SeekBar
                android:id="@+id/sbPanelSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvOpacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Opacity: 80%"
                android:textColor="@color/text_primary" />

            <SeekBar
                android:id="@+id/sbOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetSettings"
                style="@style/NexusButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset defaults" />

            <Button
                android:id="@+id/btnBackSettings"
                style="@style/NexusButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Back" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
